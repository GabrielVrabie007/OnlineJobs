@startuml LAB5_3_Bridge
title LAB 5 — Bridge Pattern
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0

package "BRIDGE PATTERN" <<Rectangle>> #LightCoral {

    ' --- Abstraction side ---
    interface IReport <<Abstraction>> {
        + Title: string
        + Exporter: IReportExporter
        + GenerateDataAsync(): Task<Dictionary>
        + ExportAsync(): Task<string>
    }

    abstract class BaseReport <<RefinedAbstraction>> {
        # _exporter: IReportExporter
        + {abstract} Title: string
        + Exporter: IReportExporter
        # BaseReport(exporter)
        + {abstract} GenerateDataAsync(): Task<Dictionary>
        + ExportAsync(): Task<string>
    }

    class JobReport <<RefinedAbstraction>> {
        - _jobService: IJobService
        + Title: string
        + GenerateDataAsync(): Task<Dictionary>
    }

    class ApplicationReport <<RefinedAbstraction>> {
        - _applicationService: IApplicationService
        + Title: string
        + GenerateDataAsync(): Task<Dictionary>
    }

    class CompanyReport <<RefinedAbstraction>> {
        - _companyService: ICompanyService
        + Title: string
        + GenerateDataAsync(): Task<Dictionary>
    }

    ' --- Implementation side ---
    interface IReportExporter <<Implementor>> {
        + Format: string
        + FileExtension: string
        + ExportAsync(title, data): Task<string>
        + GenerateHeader(title): string
        + GenerateFooter(): string
    }

    class PDFExporter <<ConcreteImplementor>> {
        + Format: string = "PDF"
        + FileExtension: string = ".pdf"
        + ExportAsync(...): Task<string>
        + GenerateHeader(...): string
        + GenerateFooter(): string
    }

    class ExcelExporter <<ConcreteImplementor>> {
        + Format: string = "Excel"
        + FileExtension: string = ".xlsx"
        + ExportAsync(...): Task<string>
        + GenerateHeader(...): string
        + GenerateFooter(): string
    }

    class JSONExporter <<ConcreteImplementor>> {
        + Format: string = "JSON"
        + FileExtension: string = ".json"
        + ExportAsync(...): Task<string>
        + GenerateHeader(...): string
        + GenerateFooter(): string
    }

    class CSVExporter <<ConcreteImplementor>> {
        + Format: string = "CSV"
        + FileExtension: string = ".csv"
        + ExportAsync(...): Task<string>
        + GenerateHeader(...): string
        + GenerateFooter(): string
    }

    class ReportingService {
        + GenerateJobReportAsync(format): Task<string>
        + GenerateApplicationReportAsync(format): Task<string>
        + GenerateCompanyReportAsync(format): Task<string>
        - GetExporter(format): IReportExporter
    }

    IReport <|.. BaseReport
    BaseReport <|-- JobReport
    BaseReport <|-- ApplicationReport
    BaseReport <|-- CompanyReport
    BaseReport o-- IReportExporter : bridge

    IReportExporter <|.. PDFExporter
    IReportExporter <|.. ExcelExporter
    IReportExporter <|.. JSONExporter
    IReportExporter <|.. CSVExporter

    ReportingService ..> IReport : creates
    ReportingService ..> IReportExporter : creates
}
@enduml





