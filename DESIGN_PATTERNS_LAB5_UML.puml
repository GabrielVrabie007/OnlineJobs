@startuml LAB5_2_Decorator
title LAB 5 — Decorator Pattern
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0

package "DECORATOR PATTERN" <<Rectangle>> #LightGreen {

    interface INotification <<Component>> {
        + SendAsync(recipient, subject, message): Task
        + GetDescription(): string
    }

    class BaseNotification <<ConcreteComponent>> {
        + SendAsync(...): Task
        + GetDescription(): string
    }

    abstract class NotificationDecorator <<Decorator>> {
        # _wrappedNotification: INotification
        # NotificationDecorator(notification)
        + SendAsync(...): Task
        + GetDescription(): string
    }

    class EmailNotificationDecorator <<ConcreteDecorator>> {
        + SendAsync(...): Task
        - SendEmail(...): Task
        + GetDescription(): string
    }

    class SMSNotificationDecorator <<ConcreteDecorator>> {
        + SendAsync(...): Task
        - SendSMS(...): Task
        + GetDescription(): string
    }

    class PushNotificationDecorator <<ConcreteDecorator>> {
        + SendAsync(...): Task
        - SendPushNotification(...): Task
        + GetDescription(): string
    }

    class LoggingNotificationDecorator <<ConcreteDecorator>> {
        - _notificationLog: List<string>
        + SendAsync(...): Task
        - LogNotification(...): void
        + GetDescription(): string
        + {static} GetNotificationLog(): List<string>
    }

    class NotificationService {
        - CreateFullNotification(): INotification
        - CreateEmailNotification(): INotification
        + SendApplicationConfirmationAsync(...)
        + NotifyEmployerNewApplicationAsync(...)
    }
    note right of NotificationService
        **Usage**:
        n = new BaseNotification();
        n = new EmailNotificationDecorator(n);
        n = new SMSNotificationDecorator(n);
        n = new PushNotificationDecorator(n);
        n = new LoggingNotificationDecorator(n);
    end note

    INotification <|.. BaseNotification
    INotification <|.. NotificationDecorator
    NotificationDecorator <|-- EmailNotificationDecorator
    NotificationDecorator <|-- SMSNotificationDecorator
    NotificationDecorator <|-- PushNotificationDecorator
    NotificationDecorator <|-- LoggingNotificationDecorator
    NotificationDecorator o-- INotification : wraps
    NotificationService ..> INotification : uses
}
@enduml


