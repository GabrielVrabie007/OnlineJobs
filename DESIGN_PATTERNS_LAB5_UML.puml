@startuml LAB5_4_Proxy
title LAB 5 — Proxy Pattern
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0

package "4A. PROTECTION PROXY" <<Rectangle>> #LightYellow {

    interface IJobPostingAccess <<Subject>> {
        + GetJobDetailsAsync(jobId): Task<JobPosting>
        + GetAllJobsAsync(): Task<IEnumerable>
        + GetCompanyName(job): string
        + GetSalaryRange(job): decimal?
    }

    class RealJobPostingAccess <<RealSubject>> {
        - _jobService: IJobService
        + GetJobDetailsAsync(jobId): Task<JobPosting>
        + GetAllJobsAsync(): Task<IEnumerable>
        + GetCompanyName(job): string
        + GetSalaryRange(job): decimal?
    }

    class JobPostingProtectionProxy <<Proxy>> {
        - _realAccess: RealJobPostingAccess
        - _isAuthenticated: bool
        - _currentUserId: Guid?
        + GetJobDetailsAsync(jobId): Task<JobPosting>
        + GetAllJobsAsync(): Task<IEnumerable>
        + GetCompanyName(job): string
        + GetSalaryRange(job): decimal?
        - GetPreviewJobAsync(jobId): Task<JobPosting>
    }
    note right of JobPostingProtectionProxy
        Unauthenticated: Company/Salary hidden,
        Description truncated.
        Authenticated: Full access.
    end note

    IJobPostingAccess <|.. RealJobPostingAccess
    IJobPostingAccess <|.. JobPostingProtectionProxy
    JobPostingProtectionProxy o-- RealJobPostingAccess : delegates to
}

package "4B. VIRTUAL PROXY" <<Rectangle>> #LightSalmon {

    interface IApplicationListAccess <<Subject>> {
        + GetApplicationsAsync(): Task<IEnumerable>
        + GetApplicationCountAsync(): Task<int>
        + GetApplicationByIdAsync(id): Task<JobApplication>
    }

    class RealApplicationListAccess <<RealSubject>> {
        - _applicationService: IApplicationService
        - _jobPostingId: Guid
        + GetApplicationsAsync(): Task<IEnumerable>
        + GetApplicationCountAsync(): Task<int>
        + GetApplicationByIdAsync(id): Task<JobApplication>
    }

    class ApplicationListVirtualProxy <<Proxy>> {
        - _realAccess: RealApplicationListAccess
        - _cachedApplications: IEnumerable?
        - _isLoaded: bool
        - _lock: object
        + GetApplicationsAsync(): Task<IEnumerable>
        + GetApplicationCountAsync(): Task<int>
        + GetApplicationByIdAsync(id): Task<JobApplication>
        + IsLoaded(): bool
        + Invalidate(): void
    }
    note right of ApplicationListVirtualProxy
        Lazy Loading: first access → DB,
        subsequent → cache.
        Thread-safe (double-check locking).
    end note

    IApplicationListAccess <|.. RealApplicationListAccess
    IApplicationListAccess <|.. ApplicationListVirtualProxy
    ApplicationListVirtualProxy o-- RealApplicationListAccess : delegates to
}


@enduml