@startuml LAB5_1_Flyweight
title LAB 5 — Flyweight Pattern
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0

package "FLYWEIGHT PATTERN" <<Rectangle>> #LightBlue {

    class SkillFlyweight <<Flyweight>> {
        - Name: string {readonly}
        - Category: string {readonly}
        + SkillFlyweight(name, category)
        + Equals(obj): bool
        + GetHashCode(): int
    }
    note right of SkillFlyweight
        **Intrinsic State**
        (Partajat între contexte)
        Imutabil - readonly properties
    end note

    class SkillFlyweightFactory <<Factory>> {
        - _skillPool: Dictionary<string, SkillFlyweight>
        - _lock: object
        + GetSkill(name, category): SkillFlyweight
        + GetPoolSize(): int
        + GetPoolStatistics(): string
        + Clear(): void
    }
    note right of SkillFlyweightFactory
        **Singleton Pattern Integration**
        Gestionează pool-ul de flyweights
        Thread-safe cu lock
    end note

    class JobSkillRequirement <<Context>> {
        + Skill: SkillFlyweight
        + RequiredProficiency: SkillProficiency
        + MinYearsOfExperience: int?
        + IsRequired: bool
        + JobSkillRequirement(...)
    }
    note right of JobSkillRequirement
        **Extrinsic State**
        (Specific fiecărui context)
        Combină flyweight cu date contextuale
    end note

    class JobPosting {
        + SkillRequirements: List<JobSkillRequirement>
    }

    enum SkillProficiency {
        Beginner
        Intermediate
        Advanced
        Expert
    }

    SkillFlyweightFactory ..> SkillFlyweight : creates/manages
    JobSkillRequirement --> SkillFlyweight : references (shared)
    JobSkillRequirement --> SkillProficiency
    JobPosting o-- JobSkillRequirement
}
@enduml



