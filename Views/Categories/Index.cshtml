@model OnlineJobs.Domain.Entities.CategoryComposite
@{
    ViewData["Title"] = "Browse by Category";
}

<div class="container mt-4 mb-5" style="max-width: 820px;">
    <h2 class="mb-1"><i class="bi bi-diagram-3"></i> Browse by Category</h2>
    <p class="text-muted">@Model.GetJobCount() active jobs across @Model.GetChildCount() areas</p>

    <div class="card">
        <div class="card-body">
            <ul class="list-unstyled mb-0 category-tree">
                @foreach (var child in Model.Children)
                {
                    @await Html.PartialAsync("_CategoryNode", child)
                }
            </ul>
        </div>
    </div>
</div>
