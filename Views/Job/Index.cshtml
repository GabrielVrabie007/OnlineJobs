@model IEnumerable<OnlineJobs.Domain.Entities.JobPosting>

@{
    ViewData["Title"] = "Browse Jobs";
    var searchTerm = Context.Request.Query["searchTerm"].ToString();
}

<div class="container mt-4 mb-5">
    <!-- Header with Search -->
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="text-gradient mb-3">
                <i class="bi bi-briefcase"></i> Browse All Jobs
            </h2>

            <!-- Search Bar -->
            @{ var searchBy = (ViewBag.SearchBy as string) ?? "Title"; }
            <form method="get" asp-action="Index" class="card mb-3">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-white">
                                    <i class="bi bi-search"></i>
                                </span>
                                <input type="text" name="searchTerm" class="form-control" placeholder="Search jobs..." value="@searchTerm" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <select name="searchBy" class="form-select form-select-lg" title="Search by">
                                <option value="Title" selected="@(searchBy == "Title")">By title</option>
                                <option value="Location" selected="@(searchBy == "Location")">By location</option>
                                <option value="Category" selected="@(searchBy == "Category")">By category</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-primary btn-lg w-100">
                                <i class="bi bi-search"></i> Search
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(searchTerm))
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i>
            Showing results for: <strong>@searchTerm</strong>
            <a asp-action="Index" class="btn btn-sm btn-outline-primary ms-2">
                <i class="bi bi-x"></i> Clear
            </a>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <!-- Results Count -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <p class="text-muted mb-0">
                <strong>@Model.Count()</strong> jobs found
            </p>
            <div class="btn-group" role="group">
                <button type="button" class="btn btn-outline-secondary btn-sm active">
                    <i class="bi bi-grid-3x3"></i> Grid
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-list-ul"></i> List
                </button>
            </div>
        </div>

        <!-- Jobs Grid -->
        <div class="row">
            @foreach (var job in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card job-card h-100 fade-in">
                        <div class="card-body d-flex flex-column">
                            <!-- Company Logo Placeholder -->
                            <div class="mb-3">
                                <div class="icon-gradient" style="width: 50px; height: 50px; font-size: 1.25rem;">
                                    <i class="bi bi-building"></i>
                                </div>
                            </div>

                            <h5 class="card-title mb-2">
                                <a asp-action="Details" asp-route-id="@job.Id" class="text-decoration-none text-dark">
                                    @job.Title
                                </a>
                            </h5>

                            <h6 class="card-subtitle mb-3 text-muted">
                                @if (job.IsCompanyRevealed)
                                {
                                    @job.Company?.Name
                                }
                                else
                                {
                                    <span>
                                        <i class="bi bi-eye-slash"></i> Company Hidden
                                    </span>
                                }
                            </h6>

                            <p class="card-text flex-grow-1">
                                @(job.Description?.Length > 100 ? job.Description.Substring(0, 100) + "..." : job.Description)
                            </p>

                            <div class="mb-3">
                                @if (!string.IsNullOrEmpty(job.Location))
                                {
                                    <small class="text-muted d-block">
                                        <i class="bi bi-geo-alt"></i> @job.Location
                                    </small>
                                }
                                @if (job.SalaryMin.HasValue && job.SalaryMax.HasValue)
                                {
                                    <small class="text-success d-block fw-bold">
                                        <i class="bi bi-currency-dollar"></i>
                                        $@job.SalaryMin.Value.ToString("N0") - $@job.SalaryMax.Value.ToString("N0")
                                    </small>
                                }
                            </div>

                            <div class="d-flex flex-wrap gap-2 mb-3">
                                @if (!string.IsNullOrEmpty(job.EmploymentType))
                                {
                                    <span class="badge bg-info text-dark">
                                        @job.EmploymentType
                                    </span>
                                }
                                @if (!string.IsNullOrEmpty(job.Category))
                                {
                                    <span class="badge badge-gradient">
                                        @job.Category.Split('>').LastOrDefault()?.Trim()
                                    </span>
                                }
                                <span class="badge job-status-@job.Status.ToString().ToLower()">
                                    @job.Status
                                </span>
                            </div>

                            <a asp-action="Details" asp-route-id="@job.Id" class="btn btn-primary w-100">
                                <i class="bi bi-eye"></i> View Details
                            </a>
                        </div>
                        <div class="card-footer bg-light text-muted small">
                            <i class="bi bi-clock"></i> Posted @job.CreatedAt.ToString("MMM dd, yyyy")
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- No Results -->
        <div class="card text-center p-5 fade-in">
            <div class="card-body">
                <div class="icon-gradient mx-auto mb-4" style="width: 80px; height: 80px; font-size: 2.5rem;">
                    <i class="bi bi-search"></i>
                </div>
                <h3 class="text-gradient mb-3">No jobs found</h3>
                <p class="text-muted mb-4">
                    @if (!string.IsNullOrEmpty(searchTerm))
                    {
                        <span>Try adjusting your search criteria or browse all available positions.</span>
                    }
                    else
                    {
                        <span>There are no job postings available at the moment. Check back soon!</span>
                    }
                </p>
                @if (!string.IsNullOrEmpty(searchTerm))
                {
                    <a asp-action="Index" class="btn btn-primary">
                        <i class="bi bi-arrow-left"></i> View All Jobs
                    </a>
                }
            </div>
        </div>
    }
</div>
