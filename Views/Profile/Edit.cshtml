@model OnlineJobs.Models.ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-4 mb-5" style="max-width: 760px;">
    <h2 class="mb-1"><i class="bi bi-person-badge"></i> My Profile</h2>
    <p class="text-muted">@Model.FullName · @Model.Email</p>

    <div class="card">
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="ProfessionalSummary" class="form-label"></label>
                    <textarea asp-for="ProfessionalSummary" class="form-control" rows="4"
                              placeholder="A short summary of who you are and what you do (50+ characters)."></textarea>
                    <span asp-validation-for="ProfessionalSummary" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Skills" class="form-label"></label>
                    <input asp-for="Skills" class="form-control" placeholder="C#, ASP.NET, SQL, React" />
                    <small class="text-muted">Separate skills with commas.</small>
                    <span asp-validation-for="Skills" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="LinkedInUrl" class="form-label"></label>
                        <input asp-for="LinkedInUrl" class="form-control" placeholder="https://linkedin.com/in/…" />
                        <span asp-validation-for="LinkedInUrl" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="GitHubUrl" class="form-label"></label>
                        <input asp-for="GitHubUrl" class="form-control" placeholder="https://github.com/…" />
                        <span asp-validation-for="GitHubUrl" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="PortfolioUrl" class="form-label"></label>
                        <input asp-for="PortfolioUrl" class="form-control" placeholder="https://…" />
                        <span asp-validation-for="PortfolioUrl" class="text-danger"></span>
                    </div>
                </div>

                <div class="text-end">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Save Profile
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
