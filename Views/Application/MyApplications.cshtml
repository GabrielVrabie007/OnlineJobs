@model IEnumerable<OnlineJobs.Models.ApplicationDetailsViewModel>

@{
    ViewData["Title"] = "My Applications";
    var userName = Context.Session.GetString("UserName");
}

<div class="container mt-4 mb-5">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-md-12">
            <h2 class="text-gradient mb-2">
                <i class="bi bi-file-earmark-text"></i> My Applications
            </h2>
            <p class="text-muted">Track the status of your job applications</p>
        </div>
    </div>

    @await Html.PartialAsync("_UndoRedoBar", new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData) { ["ReturnAction"] = "MyApplications" })

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="stat-card" style="background: var(--gradient-primary);">
                <div class="stat-icon">
                    <i class="bi bi-file-earmark"></i>
                </div>
                <div class="stat-value">@Model.Count()</div>
                <div class="stat-label">Total Applications</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);">
                <div class="stat-icon">
                    <i class="bi bi-clock"></i>
                </div>
                <div class="stat-value">@Model.Count(a => a.Status == OnlineJobs.Domain.Enums.ApplicationStatus.Submitted || a.Status == OnlineJobs.Domain.Enums.ApplicationStatus.UnderReview)</div>
                <div class="stat-label">Pending</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card" style="background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);">
                <div class="stat-icon">
                    <i class="bi bi-person-video3"></i>
                </div>
                <div class="stat-value">@Model.Count(a => a.Status == OnlineJobs.Domain.Enums.ApplicationStatus.Interviewing)</div>
                <div class="stat-label">Interviewing</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card" style="background: var(--gradient-success);">
                <div class="stat-icon">
                    <i class="bi bi-check-circle"></i>
                </div>
                <div class="stat-value">@Model.Count(a => a.Status == OnlineJobs.Domain.Enums.ApplicationStatus.Accepted)</div>
                <div class="stat-label">Accepted</div>
            </div>
        </div>
    </div>

    <!-- Filter buttons — each one re-runs the server-side Iterator with a status filter -->
    @{
        var activeFilter = ViewBag.Filter as string;
        var statuses = new[] { "Submitted", "UnderReview", "Interviewing", "Accepted", "Rejected", "Withdrawn" };
    }
    <div class="d-flex flex-wrap gap-2 mb-4">
        <a class="btn btn-sm @(string.IsNullOrEmpty(activeFilter) ? "btn-primary" : "btn-outline-primary")"
           asp-action="MyApplications">All</a>
        @foreach (var st in statuses)
        {
            <a class="btn btn-sm @(activeFilter == st ? "btn-primary" : "btn-outline-primary")"
               asp-action="MyApplications" asp-route-filter="@st">@st</a>
        }
    </div>

    @if (Model != null && Model.Any())
    {
        <!-- Applications List (already filtered + ordered by the server-side Iterator) -->
        <div>
            @foreach (var application in Model)
            {
                @await Html.PartialAsync("_ApplicationCard", application)
            }
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="card text-center p-5 fade-in">
            <div class="card-body">
                <div class="icon-gradient mx-auto mb-4" style="width: 80px; height: 80px; font-size: 2.5rem;">
                    <i class="bi bi-file-earmark-text"></i>
                </div>
                <h3 class="text-gradient mb-3">No applications yet</h3>
                <p class="text-muted mb-4">
                    Start your job search journey by applying to positions that match your skills.
                </p>
                <a asp-controller="Job" asp-action="Index" class="btn btn-primary btn-lg">
                    <i class="bi bi-search"></i> Browse Jobs
                </a>
            </div>
        </div>
    }
</div>
