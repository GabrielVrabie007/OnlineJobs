@{
    ViewData["Title"] = "Reports";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-5">
                <i class="bi bi-file-earmark-bar-graph"></i> Generate Reports
            </h1>
            <p class="lead text-muted">Export your data in multiple formats</p>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-4 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-briefcase"></i> Generate Report</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Generate" method="post">
                        <div class="mb-3">
                            <label class="form-label">Report Type</label>
                            <select name="reportType" class="form-select" required>
                                <option value="">Select report type...</option>
                                <option value="jobs">Job Postings Report</option>
                                <option value="applications">Applications Report</option>
                                <option value="companies">Companies Report</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Export Format</label>
                            <select name="format" class="form-select" required>
                                <option value="">Select format...</option>
                                <option value="PDF">PDF</option>
                                <option value="EXCEL">Excel (XLSX)</option>
                                <option value="JSON">JSON</option>
                                <option value="CSV">CSV</option>
                            </select>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-file-earmark-arrow-down"></i> Generate Report
                        </button>
                    </form>
                </div>
            </div>
        </div>

        @if (ViewBag.ReportContent != null)
        {
            <div class="col-lg-8 mb-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="bi bi-check-circle"></i> Report Generated
                        </h5>
                        <a asp-action="Download"
                           asp-route-reportType="@ViewBag.ReportType"
                           asp-route-format="@ViewBag.Format"
                           class="btn btn-light btn-sm">
                            <i class="bi bi-download"></i> Download
                        </a>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <span class="badge bg-info">@ViewBag.ReportType Report</span>
                            <span class="badge bg-secondary">@ViewBag.Format Format</span>
                            <span class="badge bg-light text-dark">Generated: @ViewBag.GeneratedAt.ToString("yyyy-MM-dd HH:mm:ss")</span>
                        </div>
                        <pre class="bg-dark text-light p-3 rounded" style="max-height: 600px; overflow-y: auto; font-size: 0.875rem;">@ViewBag.ReportContent</pre>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="col-lg-8 mb-4">
                <div class="card shadow-sm border-0">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-file-earmark-bar-graph" style="font-size: 4rem; color: #dee2e6;"></i>
                        <h4 class="mt-3 text-muted">No Report Generated Yet</h4>
                        <p class="text-muted">Select a report type and format to generate your first report</p>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="bi bi-info-circle"></i> About Reports</h5>
                </div>
                <div class="card-body">
                    <h6>Available Report Types:</h6>
                    <ul>
                        <li><strong>Job Postings Report:</strong> Statistics about all active job postings</li>
                        <li><strong>Applications Report:</strong> Your company's application statistics</li>
                        <li><strong>Companies Report:</strong> Overview of all companies on the platform</li>
                    </ul>

                    <h6 class="mt-3">Export Formats:</h6>
                    <ul>
                        <li><strong>PDF:</strong> Formatted document (simulated format)</li>
                        <li><strong>Excel:</strong> Spreadsheet format</li>
                        <li><strong>JSON:</strong> Machine-readable format</li>
                        <li><strong>CSV:</strong> Comma-separated values</li>
                    </ul>

                    <div class="alert alert-light mt-3">
                        <i class="bi bi-lightbulb"></i>
                        <strong>Design Pattern:</strong> This feature uses the <strong>Bridge Pattern</strong> to separate
                        report generation (abstraction) from export format (implementation), allowing independent extension of both.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
