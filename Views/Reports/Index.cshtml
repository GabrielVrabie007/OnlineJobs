@{
    ViewData["Title"] = "Reports";
    var doc = ViewBag.Document as OnlineJobs.Application.Reporting.ReportDocument;
    var reportType = ViewBag.ReportType as string;

    var reportOptions = new[]
    {
        ("jobs",         "bi-briefcase",   "Job postings", "Every active job with salary, location and application counts."),
        ("applications", "bi-people",      "Applications", "Candidates who applied to your jobs, with their current status."),
        ("companies",    "bi-building",    "Companies",    "Companies on the platform with size, industry and location.")
    };
}

<div class="container py-4" style="max-width: 1120px;">
    <header class="mb-4">
        <h1 class="display-6 mb-1">Reports</h1>
        <p class="text-muted mb-0">Export your jobs, applications and companies as a spreadsheet, PDF or data file.</p>
    </header>

    <div class="row g-4">
        <!-- Picker -->
        <div class="col-lg-4">
            <div class="card">
                <div class="card-body">
                    <h2 class="h6 text-uppercase text-muted mb-3" style="letter-spacing:.06em;">Choose a report</h2>
                    <div class="d-grid gap-2">
                        @foreach (var (value, icon, title, desc) in reportOptions)
                        {
                            var active = reportType == value;
                            <form asp-action="Generate" method="post" class="m-0">
                                @* Hidden input carries the report type reliably, regardless of which
                                   part of the button the user clicks. *@
                                <input type="hidden" name="reportType" value="@value" />
                                <button type="submit" class="report-pick w-100 @(active ? "is-active" : "")">
                                    <span class="report-pick__icon"><i class="bi @icon"></i></span>
                                    <span class="report-pick__text">
                                        <span class="report-pick__title">@title</span>
                                        <span class="report-pick__desc">@desc</span>
                                    </span>
                                    <i class="bi bi-arrow-right report-pick__go"></i>
                                </button>
                            </form>
                        }
                    </div>
                    <p class="text-muted small mb-0 mt-3">
                        <i class="bi bi-shield-check text-brand"></i>
                        Reports use live data and only include information you have access to.
                    </p>
                </div>
            </div>
        </div>

        <!-- Result -->
        <div class="col-lg-8">
            @if (doc != null)
            {
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
                            <div>
                                <h2 class="h4 mb-1">@doc.Title</h2>
                                <p class="text-muted small mb-0">
                                    <i class="bi bi-clock-history"></i>
                                    Generated @doc.GeneratedAt.ToString("dddd, dd MMM yyyy 'at' HH:mm")
                                    · @doc.Rows.Count record@(doc.Rows.Count == 1 ? "" : "s")
                                </p>
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                <a class="btn btn-primary btn-sm" asp-action="Download" asp-route-reportType="@reportType" asp-route-format="PDF">
                                    <i class="bi bi-filetype-pdf"></i> PDF
                                </a>
                                <a class="btn btn-outline-primary btn-sm" asp-action="Download" asp-route-reportType="@reportType" asp-route-format="EXCEL">
                                    <i class="bi bi-file-earmark-spreadsheet"></i> Excel
                                </a>
                                <a class="btn btn-outline-primary btn-sm" asp-action="Download" asp-route-reportType="@reportType" asp-route-format="CSV">
                                    <i class="bi bi-filetype-csv"></i> CSV
                                </a>
                                <a class="btn btn-outline-primary btn-sm" asp-action="Download" asp-route-reportType="@reportType" asp-route-format="JSON">
                                    <i class="bi bi-filetype-json"></i> JSON
                                </a>
                            </div>
                        </div>

                        <!-- Summary -->
                        <div class="row g-3 mb-4">
                            @foreach (var kvp in doc.Summary)
                            {
                                <div class="col-6 col-md-4">
                                    <div class="metric">
                                        <div class="metric__value">@kvp.Value</div>
                                        <div class="metric__label">@kvp.Key</div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Records -->
                        @if (doc.Columns.Count > 0 && doc.Rows.Count > 0)
                        {
                            var preview = doc.Rows.Take(25).ToList();
                            <div class="table-responsive" style="border:1px solid var(--border-hair); border-radius:12px;">
                                <table class="table table-sm align-middle mb-0">
                                    <thead>
                                        <tr>
                                            @foreach (var col in doc.Columns)
                                            {
                                                <th class="text-nowrap">@col</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in preview)
                                        {
                                            <tr>
                                                @foreach (var cell in row)
                                                {
                                                    <td class="text-nowrap">@cell</td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            @if (doc.Rows.Count > preview.Count)
                            {
                                <p class="text-muted small mb-0 mt-2">
                                    Showing @preview.Count of @doc.Rows.Count records — download the report for the full list.
                                </p>
                            }
                        }
                        else
                        {
                            <div class="text-center text-muted py-4">
                                <i class="bi bi-inbox" style="font-size:1.75rem;"></i>
                                <p class="mb-0 mt-2">No records yet for this report.</p>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="card h-100">
                    <div class="card-body d-flex flex-column align-items-center justify-content-center text-center py-5">
                        <div class="icon-circle mb-3" style="width:64px;height:64px;font-size:1.6rem;">
                            <i class="bi bi-bar-chart-line"></i>
                        </div>
                        <h2 class="h5 mb-1">Pick a report to preview</h2>
                        <p class="text-muted mb-0" style="max-width:380px;">
                            Choose a report on the left to see a live summary, then download it as
                            PDF, Excel, CSV or JSON.
                        </p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .report-pick {
        display: flex; align-items: center; gap: .85rem; width: 100%;
        text-align: left; background: var(--surface-2);
        border: 1.5px solid var(--border-hair); border-radius: 12px;
        padding: .85rem 1rem; transition: all .15s ease; cursor: pointer;
    }
    .report-pick:hover { border-color: var(--brand); }
    .report-pick.is-active { border-color: var(--ink); background: #fff; box-shadow: var(--shadow-sm); }
    .report-pick__icon {
        flex: 0 0 auto; width: 40px; height: 40px; border-radius: 10px;
        display: grid; place-items: center; font-size: 1.1rem;
        background: var(--brand-tint); color: var(--brand-strong);
    }
    .report-pick.is-active .report-pick__icon { background: var(--ink); color: #fff; }
    .report-pick__text { display: flex; flex-direction: column; line-height: 1.25; }
    .report-pick__title { font-weight: 600; color: var(--ink); }
    .report-pick__desc { font-size: .8rem; color: var(--text-secondary); }
    .report-pick__go { margin-left: auto; color: var(--text-tertiary); }
    .report-pick:hover .report-pick__go { color: var(--brand-strong); }

    .metric {
        border: 1px solid var(--border-hair); border-radius: 12px;
        padding: 1rem; height: 100%; background: var(--surface-2);
    }
    .metric__value { font-family: 'Bricolage Grotesque', sans-serif; font-size: 1.6rem; font-weight: 700; color: var(--ink); letter-spacing: -.02em; }
    .metric__label { font-size: .8rem; color: var(--text-secondary); margin-top: .15rem; }
</style>
