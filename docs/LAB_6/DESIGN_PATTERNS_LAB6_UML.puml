@startuml Command_Undo_Flow
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0

title Command Pattern - Undo/Redo Flow

actor "User" as user
participant "Controller" as controller
participant "Command\nInvoker" as invoker
participant "Command\nHistory" as history
participant "Command" as command
database "Repository" as repo

user -> controller : Execute Action
controller -> command : new Command(data)
controller -> invoker : ExecuteAsync(command)
activate invoker

invoker -> command : ExecuteAsync()
activate command
command -> repo : Update entity
repo --> command : success
command --> invoker : success
deactivate command

invoker -> history : Push(command)
activate history
history -> history : Add to undo stack
history -> history : Clear redo stack
note right: Redo cleared after new execution
history --> invoker : done
deactivate history

invoker --> controller : success
controller --> user : Success message

== User Clicks Undo ==

user -> controller : Undo()
controller -> invoker : UndoAsync()
activate invoker

invoker -> history : CanUndo()
history --> invoker : true

invoker -> history : PopUndo()
history --> invoker : command

invoker -> command : UndoAsync()
activate command
command -> repo : Restore previous state
repo --> command : success
command --> invoker : success
deactivate command

invoker -> history : PushRedo(command)
activate history
history -> history : Add to redo stack
history --> invoker : done
deactivate history

invoker --> controller : success
deactivate invoker
controller --> user : Undo successful

== User Clicks Redo ==

user -> controller : Redo()
controller -> invoker : RedoAsync()
activate invoker

invoker -> history : CanRedo()
history --> invoker : true

invoker -> history : PopRedo()
history --> invoker : command

invoker -> command : ExecuteAsync()
activate command
command -> repo : Re-apply changes
repo --> command : success
command --> invoker : success
deactivate command

invoker -> history : Push(command)
activate history
history -> history : Add back to undo stack
history --> invoker : done
deactivate history

invoker --> controller : success
deactivate invoker
controller --> user : Redo successful

@enduml

@startuml Iterator_Pattern_Flow
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0

title Iterator Pattern - Multiple Traversal Strategies

actor "Employer" as employer
participant "Application\nController" as controller
participant "Application\nCollection" as collection
participant "Filtered\nIterator" as filtered
participant "Date Ordered\nIterator" as dated
participant "Comprehensive\nScoring" as scoring

employer -> controller : ReceivedApplications(jobPostingId)
activate controller

controller -> controller : Get all applications for job
controller -> collection : new ApplicationCollection(applications)

== Filter by Status ==

controller -> collection : CreateFilteredIterator(Submitted)
collection -> filtered : new FilteredIterator(applications, Submitted)
collection --> controller : iterator

loop while HasNext()
    controller -> filtered : Next()
    filtered --> controller : application
    controller -> scoring : CalculateScore(jobSeeker, jobPosting)
    note right: **Strategy Pattern**\nScore each application
    scoring --> controller : score
    controller -> controller : Add to list with score
end

== Sort by Date ==

controller -> collection : CreateDateOrderedIterator(descending)
collection -> dated : new DateOrderedIterator(applications, false)
collection --> controller : iterator

loop while HasNext() && count < 10
    controller -> dated : Next()
    dated --> controller : application (most recent first)
    controller -> controller : Add to recent list
end

controller -> controller : Sort applications by score
controller --> employer : Display ranked applications

note over employer, scoring
  **Benefits of Iterator Pattern:**
  1. Uniform interface for different collections
  2. Multiple traversal algorithms
  3. Clean separation of concerns
  4. Easy to add new iteration strategies

  **Real Usage:**
  - Filter by status (Submitted, Approved, Rejected)
  - Sort by date (newest/oldest first)
  - Paginate results (10 per page)
  - Filter by score threshold
end note

@enduml
